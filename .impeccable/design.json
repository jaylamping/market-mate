      "html": "<label class=\"ds-search\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input aria-label=\"Filter displayed evidence\" placeholder=\"Filter displayed evidence\u2026\"/></label>",
      "css": ".ds-search{display:block;position:relative;width:250px;color:var(--muted-foreground)}.ds-search svg{position:absolute;left:10px;top:11px;width:14px;height:14px}.ds-search input{width:100%;height:36px;border:1px solid var(--input);border-radius:calc(var(--radius) - 2px);background:transparent;color:var(--foreground);font:400 12px var(--font-overview),sans-serif;padding:4px 12px 4px 32px;box-shadow:none;caret-color:var(--primary)}.ds-search input::placeholder{color:var(--muted-foreground)}.ds-search input:focus-visible{outline:2px solid var(--ring);outline-offset:3px;box-shadow:0 0 0 3px color-mix(in srgb,var(--ring) 50%,transparent)}:host-context(.dark) .ds-search input{background:color-mix(in srgb,var(--input) 30%,transparent)}"
