      "css": ".ds-panel{background:var(--card);color:var(--foreground);border:1px solid var(--border);border-radius:10px;padding:18px;font-family:var(--font-overview),sans-serif}.ds-panel h2{margin:0;color:var(--muted-foreground);font-size:12px;font-weight:500}.ds-panel strong{display:block;margin-top:14px;font-size:clamp(20px,1.8vw,27px);font-weight:450;line-height:1.25;letter-spacing:-.025em}.ds-panel p{font-size:11px;line-height:1.55;color:var(--muted-foreground)}.ds-panel a{display:block;padding-top:12px;margin-top:15px;border-top:1px solid var(--border);font-size:11px;color:var(--primary);text-decoration:none}.ds-panel a:hover{text-decoration:underline}.ds-panel a:focus-visible{outline:2px solid var(--ring);outline-offset:3px;box-shadow:0 0 0 3px color-mix(in srgb,var(--ring) 50%,transparent)}"
